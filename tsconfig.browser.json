{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./tsconfig.json",
    "compilerOptions": {
        // Guard: the main entry (and everything it imports) must type-check without @types/node,
        // so it cannot reach for node:* modules, Buffer, process, etc. Combined with the DOM-free
        // tsconfig.build.json this keeps the core to globals shared by Node and browsers.
        "lib": ["ES2022", "DOM"],
        "types": [],
        "noEmit": true
    },
    "include": [],
    "files": ["src/index.ts"]
}
